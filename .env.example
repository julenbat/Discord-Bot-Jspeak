# Configuración del bot de Discord TTS
# Copia este archivo a .env y rellena los valores.
# Las variables sin valor aquí son obligatorias salvo que el comentario indique un default.

# Token del bot (portal de Discord → Bot → Reset Token)
DISCORD_TOKEN=

# Application ID (portal de Discord → General Information)
DISCORD_APP_ID=

# Snowflake del administrador global (único usuario que puede ejecutar !tts)
DISCORD_ADMIN_ID=

# IDs de servidores permitidos, separados por comas (en cualquier otro, el bot se sale solo)
GUILD_ALLOWLIST=

# Clave del portal de Inworld (base64); se admite con o sin el prefijo "Basic "
INWORLD_API_KEY=

# Modelo de síntesis (default: inworld-tts-2; alternativa: inworld-tts-2-flash)
INWORLD_MODEL=

# Idioma de síntesis (default: es-ES)
INWORLD_LANGUAGE=

# Tarifa USD por millón de caracteres, para la estimación de coste (default: 25)
TARIFA_USD_MILLON_TTS2=

# Ídem para inworld-tts-2-flash (default: 15)
TARIFA_USD_MILLON_FLASH=

# Host de MySQL (en docker compose: db; para tests desde el host: 127.0.0.1)
MYSQL_HOST=

# Nombre de la base de datos
MYSQL_DATABASE=

# Usuario de MySQL
MYSQL_USER=

# Contraseña de MySQL
MYSQL_PASSWORD=

# Zona horaria de los logs (default: Europe/Madrid)
TZ=

# Nivel de log (default: info)
LOG_LEVEL=

# Concurrencia máxima de síntesis contra Inworld (default: 3; el plan On-Demand limita 5/cuenta)
TTS_CONCURRENCIA=

# Interruptor de emergencia: true = el bot no sintetiza nada (default: false)
TTS_KILL_SWITCH=
