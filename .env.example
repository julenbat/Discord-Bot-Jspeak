# Configuración del bot de Discord TTS
# Copia este archivo a .env y rellena los valores

# Token del bot de Discord
DISCORD_TOKEN=

# Application ID (para registro de comandos)
DISCORD_APP_ID=

# Snowflake del administrador global
DISCORD_ADMIN_ID=

# IDs de servidores permitidos, separados por comas
GUILD_ALLOWLIST=

# Clave del portal Inworld (base64); se admite con o sin "Basic "
INWORLD_API_KEY=

# Modelo de síntesis de voz Inworld
INWORLD_MODEL=inworld-tts-2

# Idioma de síntesis
INWORLD_LANGUAGE=es-ES

# Tarifa USD por millón de caracteres para inworld-tts-2
TARIFA_USD_MILLON_TTS2=25

# Tarifa USD por millón de caracteres para inworld-tts-2-flash
TARIFA_USD_MILLON_FLASH=15

# Host de la base de datos MySQL
MYSQL_HOST=db

# Nombre de la base de datos
MYSQL_DATABASE=albas_tts

# Usuario de MySQL
MYSQL_USER=bot

# Contraseña de MySQL
MYSQL_PASSWORD=

# Zona horaria
TZ=Europe/Madrid

# Nivel de log
LOG_LEVEL=info

# Semáforo global de síntesis (concurrencia máxima)
TTS_CONCURRENCIA=3

# Kill switch para desactivar TTS globalmente (true/false)
TTS_KILL_SWITCH=false
